# Copy to .env (git-ignored). Both are free; the app runs without either.
# data.gov.in API key for the CPCB real-time AQI feed: https://data.gov.in (sign up, then "My Account" → API key)
DATA_GOV_API_KEY=
# Google AI Studio key in a project with NO billing (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the free-tier model (default gemini-3.5-flash-lite)
GEMINI_MODEL=
